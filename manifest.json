{
  "manifest_version": 3,
  "name": "FeedShield",
  "version": "0.9.19",
  "description": "Local feed controls, RSS/Atom reading and an opt-in customizable hydration cat.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://www.etsy.com/*",
    "https://www.instagram.com/*",
    "https://www.facebook.com/*",
    "https://www.youtube.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.reddit.com/*",
    "https://www.pinterest.com/*",
    "https://bsky.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FeedShield"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "browser-api.js",
        "settings-model.js",
        "settings.js",
        "feed-policy.js",
        "item-safety.js",
        "content.js",
        "chippy-placement.js",
        "chippy-frames.js",
        "chippy-renderer.js",
        "chippy-appearance.js",
        "chippy-care.js",
        "chippy-live.js",
        "site-status-content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.etsy.com/*"
      ],
      "js": [
        "browser-api.js",
        "settings-model.js",
        "settings.js",
        "item-safety.js",
        "etsy.js",
        "chippy-placement.js",
        "chippy-frames.js",
        "chippy-renderer.js",
        "chippy-appearance.js",
        "chippy-care.js",
        "chippy-live.js",
        "site-status-content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://www.facebook.com/*",
        "https://www.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://www.pinterest.com/*",
        "https://bsky.app/*"
      ],
      "js": [
        "browser-api.js",
        "settings-model.js",
        "settings.js",
        "item-safety.js",
        "generic.js",
        "chippy-placement.js",
        "chippy-frames.js",
        "chippy-renderer.js",
        "chippy-appearance.js",
        "chippy-care.js",
        "chippy-live.js",
        "site-status-content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "version_name": "0.9.19 cross-browser preview",
  "web_accessible_resources": [
    {
      "resources": [
        "assets/chippy/1.gif",
        "assets/chippy/1.png",
        "assets/chippy/2.gif",
        "assets/chippy/2.png",
        "assets/chippy/3.gif",
        "assets/chippy/3.png",
        "assets/chippy/4.gif",
        "assets/chippy/4.png",
        "assets/chippy/5.gif",
        "assets/chippy/5.png",
        "assets/chippy/6.gif",
        "assets/chippy/6.png",
        "assets/chippy/7.gif",
        "assets/chippy/7.png",
        "assets/chippy/8.gif",
        "assets/chippy/8.png",
        "assets/chippy/9.gif",
        "assets/chippy/9.png",
        "assets/chippy/10.gif",
        "assets/chippy/10.png",
        "assets/chippy/1-atlas.png",
        "assets/chippy/2-atlas.png",
        "assets/chippy/3-atlas.png",
        "assets/chippy/4-atlas.png",
        "assets/chippy/5-atlas.png",
        "assets/chippy/6-atlas.png",
        "assets/chippy/7-atlas.png",
        "assets/chippy/8-atlas.png",
        "assets/chippy/9-atlas.png",
        "assets/chippy/10-atlas.png"
      ],
      "matches": [
        "https://www.tiktok.com/*",
        "https://www.etsy.com/*",
        "https://www.instagram.com/*",
        "https://www.facebook.com/*",
        "https://www.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://www.pinterest.com/*",
        "https://bsky.app/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
